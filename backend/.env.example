# Supabase Postgres connection string
# Find this in: Supabase Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Secret key used to sign JWT access tokens
# Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-string

# JWT signing algorithm (HS256 is fine for a single-server app)
JWT_ALGORITHM=HS256

# How long access tokens stay valid, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Gemini API key for LLM-based style parsing
# Get from aistudio.google.com -> Get API key
GEMINI_API_KEY=your-gemini-api-key-here
